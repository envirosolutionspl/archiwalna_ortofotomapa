   <property name="styleSheet">
    <string notr="true">QWidget#dockWidgetContents { background-color: #ffffff; }
QLabel { background: transparent; color: #2b2b2b; }

/* ---------- NAGŁÓWEK ---------- */
QFrame#headerFrame { background-color: #ffffff; border: none; border-bottom: 2px solid #3d5a2a; }
QLabel#lbl_title { color: #3d5a2a; font-size: 13pt; font-weight: bold; }
QLabel#lbl_pluginVersion { color: #6b6b6b; font-size: 8pt; }
QToolButton#btn_help {
    background-color: #ffffff; color: #444444; font-weight: normal; font-size: 8pt;
    outline: none; min-width: 22px; max-width: 22px; min-height: 22px; max-height: 22px;
}
QToolButton#btn_help:hover { color: #3d5a2a; border-color: #3d5a2a; }

/* ---------- KARTA „PASEK CZASU” ---------- */
QFrame#groupFrame { background-color: #ffffff; border: 1px solid #b9c7b9; border-radius: 8px; }
QLabel#label_2 {
    background-color: #b9c7b9; color: #2b2b2b; font-size: 9pt; font-weight: bold;
    padding: 4px 4px; border: none;
    border-top-left-radius: 7px; border-top-right-radius: 7px;
}
QLabel#lbl_selectedCaption { color: #6b6b6b; font-size: 7pt; }
QLabel#timeLabel { color: #3d5a2a; font-size: 20pt; font-weight: bold; }
QLabel#lbl_minYear, QLabel#lbl_maxYear { color: #444444; font-size: 7pt; font-weight: bold; }
QLabel#lbl_info { color: #555555; font-size: 7pt; }

QToolButton#btn_first, QToolButton#btn_prev, QToolButton#btn_next, QToolButton#btn_last {
    background-color: #ffffff; color: #333333; font-size: 10pt; font-weight: bold;
    border: 1px solid #c9cfc0; border-radius: 6px;
    min-width: 24px; max-width: 24px; min-height: 24px; max-height: 24px;
}
QToolButton#btn_first:hover, QToolButton#btn_prev:hover,
QToolButton#btn_next:hover, QToolButton#btn_last:hover { background-color: #f3f6ef; border-color: #3d5a2a; }
QToolButton#btn_first:pressed, QToolButton#btn_prev:pressed,
QToolButton#btn_next:pressed, QToolButton#btn_last:pressed { background-color: #e4e9dc; }
QToolButton#btn_first:disabled, QToolButton#btn_prev:disabled,
QToolButton#btn_next:disabled, QToolButton#btn_last:disabled { color: #c8c8c8; border-color: #e6e6e6; }

QSlider#timeSlider { min-height: 18px; background: transparent; }
QSlider#timeSlider::groove:horizontal { height: 6px; background: #e2e6dc; border-radius: 3px; }
QSlider#timeSlider::sub-page:horizontal { background: #3d5a2a; border-radius: 3px; }
QSlider#timeSlider::add-page:horizontal { background: #e2e6dc; border-radius: 3px; }
QSlider#timeSlider::handle:horizontal {
    background: #ffffff; border: 3px solid #3d5a2a;
    width: 12px; height: 12px; margin: -6px 0; border-radius: 9px;
}
QSlider#timeSlider::handle:horizontal:hover { background: #f3f6ef; }

/* ---------- STOPKA ---------- */
QFrame#footerFrame { background-color: #eef3ee; border: none; border-top: 1px solid #d6dbcf; }
QLabel#lbl_systemy, QLabel#lbl_szkolenia { font-size: 7pt; padding: 2px 1px; border: none; border-bottom: none }
QLabel#lbl_esName { color: #3d5a2a; font-size: 13pt; }
QLabel#lbl_esTagline { color: #555555; font-size: 5pt; font-weight: bold; }
QLabel#lbl_copyrights { color: #8a8a8a; font-size: 5pt; }

/* ---------- MOTYW CIEMNY (właściwość theme ustawia kod; reguły wyżej to motyw jasny) ---------- */
QWidget#dockWidgetContents[theme=&quot;dark&quot;] { background-color: #2b2d2e; }
QWidget[theme=&quot;dark&quot;] QLabel { color: #e6e9e7; }

QWidget[theme=&quot;dark&quot;] QFrame#headerFrame { background-color: #2b2d2e; border-bottom: 2px solid #5a6162; }
QWidget[theme=&quot;dark&quot;] QLabel#lbl_title { color: #a9cfac; }
QWidget[theme=&quot;dark&quot;] QLabel#lbl_pluginVersion { color: #9aa4a0; }
QWidget[theme=&quot;dark&quot;] QToolButton#btn_help { background-color: #2b2d2e; color: #e6e9e7; }
QWidget[theme=&quot;dark&quot;] QToolButton#btn_help:hover { color: #a9cfac; border-color: #6f9c73; }

QWidget[theme=&quot;dark&quot;] QFrame#groupFrame { background-color: #262829; border: 1px solid #4c6e4f; }
QWidget[theme=&quot;dark&quot;] QLabel#label_2 { background-color: #4c6e4f; color: #ffffff; }
QWidget[theme=&quot;dark&quot;] QLabel#lbl_selectedCaption { color: #9aa4a0; }
QWidget[theme=&quot;dark&quot;] QLabel#timeLabel { color: #a9cfac; }
QWidget[theme=&quot;dark&quot;] QLabel#lbl_minYear, QWidget[theme=&quot;dark&quot;] QLabel#lbl_maxYear { color: #b8c0bc; }
QWidget[theme=&quot;dark&quot;] QLabel#lbl_info { color: #b8c0bc; }

QWidget[theme=&quot;dark&quot;] QToolButton#btn_first, QWidget[theme=&quot;dark&quot;] QToolButton#btn_prev,
QWidget[theme=&quot;dark&quot;] QToolButton#btn_next, QWidget[theme=&quot;dark&quot;] QToolButton#btn_last { background-color: #262829; color: #e6e9e7; border: 1px solid #5a6162; }
QWidget[theme=&quot;dark&quot;] QToolButton#btn_first:hover, QWidget[theme=&quot;dark&quot;] QToolButton#btn_prev:hover,
QWidget[theme=&quot;dark&quot;] QToolButton#btn_next:hover, QWidget[theme=&quot;dark&quot;] QToolButton#btn_last:hover { background-color: #2c3a2d; border-color: #6f9c73; }
QWidget[theme=&quot;dark&quot;] QToolButton#btn_first:pressed, QWidget[theme=&quot;dark&quot;] QToolButton#btn_prev:pressed,
QWidget[theme=&quot;dark&quot;] QToolButton#btn_next:pressed, QWidget[theme=&quot;dark&quot;] QToolButton#btn_last:pressed { background-color: #1f2a20; }
QWidget[theme=&quot;dark&quot;] QToolButton#btn_first:disabled, QWidget[theme=&quot;dark&quot;] QToolButton#btn_prev:disabled,
QWidget[theme=&quot;dark&quot;] QToolButton#btn_next:disabled, QWidget[theme=&quot;dark&quot;] QToolButton#btn_last:disabled { color: #6f7773; border-color: #3a3f40; }

QWidget[theme=&quot;dark&quot;] QSlider#timeSlider::groove:horizontal { background: #44494a; }
QWidget[theme=&quot;dark&quot;] QSlider#timeSlider::sub-page:horizontal { background: #6f9c73; }
QWidget[theme=&quot;dark&quot;] QSlider#timeSlider::add-page:horizontal { background: #44494a; }
QWidget[theme=&quot;dark&quot;] QSlider#timeSlider::handle:horizontal { background: #262829; border: 3px solid #e6e9e7; }
QWidget[theme=&quot;dark&quot;] QSlider#timeSlider::handle:horizontal:hover { background: #2c3a2d; }

QWidget[theme=&quot;dark&quot;] QFrame#footerFrame { background-color: #303334; border-top: 1px solid #44494a; }
QWidget[theme=&quot;dark&quot;] QLabel#lbl_esName { color: #a9cfac; }
QWidget[theme=&quot;dark&quot;] QLabel#lbl_esTagline { color: #9aa4a0; }
QWidget[theme=&quot;dark&quot;] QLabel#lbl_copyrights { color: #8a918e; }</string>
